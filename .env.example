# Copia este archivo a .env y rellénalo. No subas el .env a git.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Correo (verificación de email y recuperar contraseña) — Brevo, por API web.
# Si se dejan vacías, el registro NO exige verificar el email (solo para desarrollo).
BREVO_API_KEY=
MAIL_FROM=
